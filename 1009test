cp ~/AutoVehicle/morai_ws/docker/final_ws/highway.env morai_ws/docker/final_ws/
cp ~/AutoVehicle/morai_ws/docker/final_ws/highway-test.env morai_ws/docker/final_ws/
nano morai_ws/docker/final_ws/highway.env
highway.env에서 다음 세 값을 설정하세요.
UBUNTU_IP=192.168.10.21
MORAI_IP=192.168.10.14
CONTAINER_NAME=morai-highway-153-net10

cd ~/AutoVehicle
git pull --ff-only origin final_ws
git rev-parse --short HEAD   # 6fc1014 확인
cd morai_ws/docker/final_ws
bash run_highway.sh stop
bash install_curvature_signal.sh
bash run_highway.sh start
bash run_test.sh clearance 6
bash run_test.sh show 2


별도 터미널에서 주행을 시작하세요.
cd ~/AutoVehicle/morai_ws/docker/final_ws
bash run_test.sh drive 2



cd ~/AutoVehicle-finalws-20261012
git fetch origin final_ws
git switch --detach origin/final_ws
cd morai_ws/docker/final_ws
bash run_highway.sh stop
bash install_curvature_signal.sh --config
bash run_highway.sh start
bash run_test.sh turn mission
bash run_test.sh lane on
bash run_test.sh show 2
bash run_test.sh drive 2



cd ~/AutoVehicle-finalws-20261012/morai_ws/docker/final_ws
bash run_highway.sh shell
(morai-venv)가 뜨면 그 안에서 다음을 입력하세요.
rostopic echo -n 1 /experimental/curvature_progress
rostopic echo -n 1 /localization/odometry/pose/pose/position
첫 결과의 data가 경로 시작점부터의 거리 **s(m)**이고, 두 번째 결과의 x, y가 차량의 현재 지도 좌표입니다.
가장 가까운 MGeo 링크 ID와 경로상 투영 위치까지 확인하려면, 컨테이너에서 exit한 뒤 방금 얻은 좌표를 넣어 실행하세요.
cd ~/AutoVehicle-finalws-20261012
python3 morai_ws/src/control/purepursuit_mgeo/scripts/locate_route_region.py \
  --xy X값 Y값 --hint-s S값 \
  --path-file morai_ws/data/routes/2026_molit_comp_global_path.txt \
  --link-set-file morai_ws/src/detection/camera_perception/lane/mgeo/R_KR_PR_K-city_2025/link_set.json
